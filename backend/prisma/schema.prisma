// ============================================================
// GESTOR DE BIENES — schema.prisma
// Base de datos SQLite (app de escritorio, un solo abogado)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// PERFIL DEL ABOGADO (un solo registro real, la app es de un solo usuario)
// ------------------------------------------------------------
model Abogado {
  id                String   @id @default(cuid())
  nombreCompleto    String
  tarjetaProfesional String?
  documentoIdentidad String?
  despacho          String?
  correo            String   @unique
  telefono          String?
  ciudad            String?
  areaEspecialidad  String?
  paginaWeb         String?
  fotoPerfilUrl     String?
  pinHash           String   // PIN de 6 dígitos, siempre guardado con hash, nunca en texto plano
  intentosFallidos  Int      @default(0)
  bloqueadoHasta    DateTime?
  codigoRecuperacionHash String?
  codigoRecuperacionPendiente String? // Se muestra una única vez al iniciar sesión y luego se borra
  temaVisual        TemaVisual @default(BLANCO_CORPORATIVO)
  densidadTablas    DensidadTablas @default(COMODA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TemaVisual {
  BLANCO_CORPORATIVO
  GRIS_TECNICO
  NEGRO_EJECUTIVO
}

enum DensidadTablas {
  COMPACTA
  COMODA
  AMPLIA
}

// ------------------------------------------------------------
// CATÁLOGO GENERAL DE LEYES (configurable, editable, se precarga en cada caso nuevo)
// ------------------------------------------------------------
model Ley {
  id              String   @id @default(cuid())
  nombre          String
  codigoLey       String?
  articulo        String?
  descripcion     String?
  porcentajeBase  Float
  aplicaA         TipoRelacion?
  grupo           GrupoLey
  activaPorDefecto Boolean @default(true)

  procesosLeyes   ProcesoLey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GrupoLey {
  REPARTO_TESTADO
  REPARTO_INTESTADO
}

// ------------------------------------------------------------
// PROCESO (un caso de partición de bienes)
// ------------------------------------------------------------
model Proceso {
  id                String        @id @default(cuid())
  nombreCaso        String
  tipoProceso       TipoProceso
  tipoSucesion      TipoSucesion?
  viaProceso        ViaProceso    @default(NOTARIAL)
  estado            EstadoProceso @default(PENDIENTE)
  notasLitigacion   String?

  patrimonioBruto   Float @default(0)
  patrimonioNeto    Float @default(0)

  bienes            Bien[]
  personas          Persona[]
  leyesAplicadas    ProcesoLey[]
  costos            CostoProceso[]
  resultados        ResultadoPersona[]

  fechaCreacion     DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
  fechaFinalizacion DateTime?
  pdfGeneradoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TipoProceso {
  SUCESION
  SOCIEDAD_CONYUGAL
  DISOLUCION_SOCIETARIA
  COPROPIEDAD
}

enum TipoSucesion {
  TESTADA
  INTESTADA
}

enum ViaProceso {
  NOTARIAL
  JUDICIAL
}

enum EstadoProceso {
  PENDIENTE
  FINALIZADO
}

// ------------------------------------------------------------
// BIENES / EMPRESAS de un proceso
// ------------------------------------------------------------
model Bien {
  id              String  @id @default(cuid())
  procesoId       String
  proceso         Proceso @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  nombre          String
  categoria       CategoriaBien @default(OTRO)
  valorComercial  Float
  esBienPropio    Boolean @default(false)

  createdAt DateTime @default(now())
}

enum CategoriaBien {
  INMUEBLE
  VEHICULO
  CUENTA_INVERSION
  EMPRESA
  OTRO
}

// ------------------------------------------------------------
// PERSONAS involucradas en un proceso
// ------------------------------------------------------------
model Persona {
  id              String   @id @default(cuid())
  procesoId       String
  proceso         Proceso  @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  nombre          String
  tipoRelacion    TipoRelacion
  parentesco      Parentesco?
  porcentajeEscritura Float?

  esIndigno       Boolean @default(false)
  esDesheredado   Boolean @default(false)

  resultados      ResultadoPersona[]
  costoProcesoPartes CostoProcesoParte[]

  createdAt DateTime @default(now())
}

enum TipoRelacion {
  HIJO
  CONYUGE
  PADRE
  HERMANO
  TIO
  PRIMO
  SOBRINO
  ABUELO
  AMIGO
  SOCIO
  COMUNERO
  OTRO
}

enum Parentesco {
  HIJO
  CONYUGE
  PADRE
  HERMANO
  TIO
  PRIMO
  SOBRINO
  ABUELO
  OTRO
}

// ------------------------------------------------------------
// LEYES APLICADAS a un proceso específico (motor de reglas activo)
// ------------------------------------------------------------
model ProcesoLey {
  id              String  @id @default(cuid())
  procesoId       String
  proceso         Proceso @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  leyId           String
  ley             Ley     @relation(fields: [leyId], references: [id])

  porcentajeCaso  Float
  activa          Boolean @default(true)
  baseCalculoLeyId String?

  @@unique([procesoId, leyId])
}

// ------------------------------------------------------------
// COSTOS DEL PROCESO — Honorarios de Abogado y Agencias en Derecho
// ------------------------------------------------------------
model CostoProceso {
  id              String  @id @default(cuid())
  procesoId       String
  proceso         Proceso @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  tipo            TipoCosto
  modalidad       ModalidadCosto
  porcentaje      Float?
  montoFijo       Float?

  estadoFijacion  EstadoFijacion?
  partes          CostoProcesoParte[]

  createdAt DateTime @default(now())
}

enum TipoCosto {
  HONORARIOS_ABOGADO
  AGENCIAS_DERECHO
}

enum ModalidadCosto {
  PORCENTAJE
  MONTO_FIJO
}

enum EstadoFijacion {
  ESTIMADO
  CONFIRMADO_SENTENCIA
}

// Tabla intermedia: quién paga / quién recibe una Agencia en Derecho
model CostoProcesoParte {
  id              String @id @default(cuid())
  costoProcesoId  String
  costoProceso    CostoProceso @relation(fields: [costoProcesoId], references: [id], onDelete: Cascade)

  personaId       String
  persona         Persona @relation(fields: [personaId], references: [id])
  rol             RolParte

  @@unique([costoProcesoId, personaId, rol])
}

enum RolParte {
  QUIEN_PAGA
  QUIEN_RECIBE
}

// ------------------------------------------------------------
// RESULTADO FINAL — snapshot de cuánto le corresponde a cada persona
// ------------------------------------------------------------
model ResultadoPersona {
  id              String  @id @default(cuid())
  procesoId       String
  proceso         Proceso @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  personaId       String
  persona         Persona @relation(fields: [personaId], references: [id])

  montoAsignado   Float
  reglaAplicada   String

  createdAt DateTime @default(now())
}